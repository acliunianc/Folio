{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "mainBinaryName": "Folio",
  "version": "0.1.0",
  "identifier": "com.workspace.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Folio",
        "width": 1280,
        "height": 800,
        "visible": false,
        "decorations": false,
        "skipTaskbar": true,
        "resizable": true,
        "alwaysOnTop": true,
        "dragDropEnabled": true,
        "shadow": false
      }
    ],
    "appDirectoriesOverride": "./app-data",
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
